# Copie para infra/docker/.env na VPS e preencha. Nunca versione o .env.
# Gere segredos com: openssl rand -hex 32  (hex evita caracteres que quebram a URL do banco)

IMAGE_TAG=latest
# Porta em 127.0.0.1 onde o Nginx da máquina encontra a API.
API_PORT=3000

POSTGRES_USER=kora
POSTGRES_DB=kora
POSTGRES_PASSWORD=troque-por-um-segredo-hex
# Porta em 127.0.0.1 para acessar o banco via túnel SSH (DBeaver etc.).
POSTGRES_PORT=5432

# Variáveis lidas pela API
LOG_LEVEL=info
FRONTEND_ORIGINS=https://app.example.com
# 1 = um proxy confiável na frente (o Nginx da máquina).
TRUST_PROXY=1
JWT_ACCESS_SECRET=troque-por-um-segredo-hex
PASSWORD_PEPPER=troque-por-um-segredo-hex
COOKIE_SECURE=true

# E-mail (SMTP) — usado no "esqueceu a senha". Ex.: Brevo, Resend, SES ou Gmail.
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=troque
SMTP_PASS=troque
MAIL_FROM=Kora <nao-responda@korapag.com>
APP_URL=https://app.korapag.com
