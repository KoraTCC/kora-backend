# Copie para apps/api/.env para desenvolvimento local.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgres://kora:kora@localhost:5432/kora
FRONTEND_ORIGINS=http://localhost:5173
TRUST_PROXY=0

# Auth (em produção use: openssl rand -hex 32)
JWT_ACCESS_SECRET=dev-only-troque-este-segredo-de-jwt-0000000000
PASSWORD_PEPPER=dev-only-troque-este-pepper-de-senha-00000000
# Cookies Secure exigem HTTPS; em localhost via http deixe false.
COOKIE_SECURE=false
